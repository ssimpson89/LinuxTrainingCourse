# myorg-seed.repo: upstream repositories MyOrg takes everything it did not
# rebuild from (the "seed"). The seed is an input, not part of the identity.
# $seed_baseurl comes from /etc/dnf/vars/seed_baseurl.
[seed-baseos]
name=Seed (upstream) BaseOS $releasever - $basearch
baseurl=$seed_baseurl/$releasever/BaseOS/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-upstream-seed
priority=99

[seed-appstream]
name=Seed (upstream) AppStream $releasever - $basearch
baseurl=$seed_baseurl/$releasever/AppStream/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-upstream-seed
priority=99

[seed-crb]
name=Seed (upstream) CRB $releasever - $basearch
baseurl=$seed_baseurl/$releasever/CRB/$basearch/os/
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-upstream-seed
priority=99
